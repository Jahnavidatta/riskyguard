# =========================================================================
# RiskRadar - AI-Powered Digital Risk Protection Platform
# Environment Configuration Template
# =========================================================================

# Database Configuration
# Default: Zero-config SQLite (portable local storage)
DATABASE_URL=sqlite:///./riskradar.db

# PostgreSQL Production Example:
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/riskradar

# Authentication & JWT Security
# Generate a secure 32+ character key for production (e.g., openssl rand -hex 32)
SECRET_KEY=riskradar-secure-jwt-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# CORS Settings (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
